# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com

# PostgreSQL
POSTGRES_DB=real_estate_db
POSTGRES_USER=real_estate_user
POSTGRES_PASSWORD=change-this-password

# Database URL (Docker / Render)
DATABASE_URL=postgresql://real_estate_user:change-this-password@db:5432/real_estate_db
DATABASE_SSL=false

# External APIs
OPENWEATHER_API_KEY=your-openweather-api-key
WEATHER_CITY=Minsk
API_REQUEST_TIMEOUT=5

# Logging
LOG_LEVEL=INFO

# Gunicorn (Docker / Render)
GUNICORN_WORKERS=2