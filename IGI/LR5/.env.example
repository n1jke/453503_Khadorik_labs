# Django
# SECRET_KEY: random string (generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=your-secret-key-here
# DEBUG: True for local dev, False on Render production
DEBUG=True
# ALLOWED_HOSTS: comma-separated, no spaces. Add your Render domain without https://
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com

# Database
# Local SQLite: leave DATABASE_URL empty or comment out the line
# Local + Render DB from PC: External URL + DATABASE_SSL=true
# Render Web Service (same account): Internal URL + DATABASE_SSL=false
# Docker Compose: postgresql://real_estate_user:password@db:5432/real_estate_db
# No DATABASE_URL: SQLite (db.sqlite3)
DATABASE_URL=postgresql://real_estate_user:password@host.example.com:5432/real_estate_db_8avy
DATABASE_SSL=true

# External APIs
OPENWEATHER_API_KEY=your-openweather-api-key
WEATHER_CITY=Minsk
API_REQUEST_TIMEOUT=5

# Logging
LOG_LEVEL=INFO

# Gunicorn (Docker / Render)
GUNICORN_WORKERS=2

# Render production template: see .env.example.render
