# Local env example for development with SQLite and debug mode enabled.

# ==============================================================================
# Django Core config
# ==============================================================================

# Generate a new: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-for-dev

# Enable debug mode 
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Language code
LANGUAGE_CODE=ru-ru

# Timezone (Django will use UTC and convert in templates via USE_TZ=True)
TIME_ZONE=UTC

# ==============================================================================
# DB config
# ==============================================================================

# DATABASE_URL is empty for local development — django will use SQLite
DATABASE_URL=


# ==============================================================================
# External api-s
# ==============================================================================

# OpenWeatherMap API key for weather widget
# key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# default city for weather widget (use if request fails)
WEATHER_CITY=Minsk

# http request timeout for external api-s
API_REQUEST_TIMEOUT=5

# ==============================================================================
# Logging
# ==============================================================================

# Log level for application and Django loggers
LOG_LEVEL=INFO

# ==============================================================================
# Notes 
# ==============================================================================

# 1. After creating .env, run migrations:
#    python manage.py migrate

# 2. You can load demo data:
#    python manage.py load_demo_data
#    python manage.py load_demo_data --ensure-images

# 3. Run server:
#    python manage.py runserver

# 4. Demo users (from load_demo_data):
#    Employees: employee1..employee12 with password: employee123
#    Admin: Create with: python manage.py createsuperuser

