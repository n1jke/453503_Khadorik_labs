# =============================================================================
# Render.com Web Service - Environment Variables
# =============================================================================
# Copy each KEY=VALUE into: Web Service > Settings > Environment
# (or link DATABASE_URL from the PostgreSQL service via "Add from database")
#
# Do NOT commit real secrets. This file is a template only.
# Root Directory on Render: IGI/LR5
# =============================================================================

# --- Required ---

# Generate locally:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=todo

DEBUG=True

# Your Render hostname only (no https://, no trailing slash)
# Example: real-estate-agency.onrender.com
ALLOWED_HOSTS=todo

# Internal Database URL from Render PostgreSQL > Connections > Internal Database URL
# Format: postgresql://USER:PASSWORD@dpg-xxxxx-a/DATABASE_NAME
# Use Internal URL for Web Service in the same Render account (not External).
DATABASE_URL=postgresql://real_estate_user:bfA9A1NwQp53fdsZSgujppzW9C3zM0bv@dpg-d880rd19rddc73b1ns20-a/real_estate_db_8avy

# false for Internal URL on Render; true only if you use External URL
DATABASE_SSL=false

# --- Recommended ---

LOG_LEVEL=INFO

# Render build/runtime (Dashboard > Environment or render.yaml)
PYTHON_VERSION=3.11.9

# Used by entrypoint.sh / gunicorn in Docker; optional on Render if startCommand sets workers
GUNICORN_WORKERS=2

# --- Optional (site features) ---

OPENWEATHER_API_KEY=todo
WEATHER_CITY=Minsk
API_REQUEST_TIMEOUT=5

# =============================================================================
# Render Dashboard checklist
# =============================================================================
# 1. PostgreSQL: create DB, copy Internal Database URL into DATABASE_URL
# 2. Web Service > Build Command:
#      pip install -r requirements.txt && python manage.py collectstatic --noinput && python manage.py migrate
# 3. Web Service > Start Command:
#      gunicorn RealEstateAgency.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --timeout 120
# 4. Demo data / images (Docker entrypoint runs this automatically):
#      python manage.py load_demo_data
#      python manage.py load_demo_data --ensure-images
# 5. After deploy (Shell):
#      python manage.py createsuperuser
# Commit to Git for host: static/, templates/, media/ (not media/charts/)
# =============================================================================
